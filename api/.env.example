PROJECT_NAME="Restaurant Review Insights API"
DATABASE_URL="sqlite:///./data.db"
OPENAI_API_KEY="" # Required for OpenAI TTS provider
OPENAI_MODEL="gpt-4o-mini"
TTS_PROVIDER="openai" # Set to openai or kokoro
TTS_BASE_URL="" # Required for kokoro, optional for openai
TTS_MODEL="kokoro"
TTS_VOICE="af_heart"
OPENAI_TTS_MODEL="gpt-4o-mini-tts"
OPENAI_TTS_VOICE="coral"
OPENAI_TTS_TIMEOUT=30
TTS_ENDPOINT_TIMEOUT=30
GOOGLE_PLACES_API_KEY=""
AUTH_SECRET_KEY=""
AUTH_BOOTSTRAP_KEY=""
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173"]
# Market comparison (docs/market-comparison.md). Use MIN_REVIEWS_PER_CRITERION=20 in production.
COMPETITOR_MIN_SUGGESTIONS=5
COMPETITOR_MAX_SUGGESTIONS=10
MIN_REVIEWS_PER_CRITERION=3
GAP_TIE_MARGIN=0.3
GAP_WEAK_COMPETITOR_AVG=3.5
